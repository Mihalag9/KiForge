@echo off
setlocal
chcp 65001 >nul 2>&1
title KiForge
cd /d "%~dp0"

rem ------------------------------------------------------------------
rem  Если есть виртуальное окружение - берём Python из него,
rem  иначе системный Python из PATH.
rem ------------------------------------------------------------------
if exist ".venv\Scripts\python.exe" (
    set "PY=.venv\Scripts\python.exe"
) else (
    set "PY=python"
)

rem ------------------------------------------------------------------
rem  Запуск программы. Окно cmd живёт ровно столько, сколько работает
rem  KiForge: закрыли программу - окно закрывается вместе с ней.
rem ------------------------------------------------------------------
"%PY%" main.py

rem ------------------------------------------------------------------
rem  Окно остаётся открытым ТОЛЬКО при аварийном завершении, чтобы можно
rem  было прочитать текст ошибки. При обычном закрытии программы окно
rem  закрывается сразу, без всякого "Нажмите любую клавишу".
rem ------------------------------------------------------------------
if %errorlevel% neq 0 (
    echo.
    echo [KiForge] Программа завершилась с ошибкой - текст ошибки выше.
    pause
)

endlocal
exit /b 0


rem ==================================================================
rem  Вариант Б: запуск вообще без окна cmd, если такой режим больше
rem  нравится. Замените весь файл на две строки ниже - тогда консоль
rem  исчезает сразу после запуска, а программа работает без неё.
rem  Минус: текст ошибки при сбое запуска нигде не будет виден.
rem
rem  @echo off
rem  start "" "%~dp0.venv\Scripts\pythonw.exe" main.py
rem ==================================================================
